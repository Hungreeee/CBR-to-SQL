----------
PREDS:
SELECT AVG(CASE WHEN strftime('%J',patients.dod) - strftime('%J',diagnoses_icd.charttime) < 365/4 THEN 0 ELSE 1 END) FROM diagnoses_icd JOIN patients ON patients.subject_id = diagnoses_icd.subject_id WHERE diagnoses_icd.icd_code = ( SELECT d_icd_diagnoses.icd_code FROM d_icd_diagnoses WHERE d_icd_diagnoses.long_title = 'asymptomatic human immunodeficiency virus [hiv] infection status' ) AND strftime('%J',current_time) - strftime('%J',diagnoses_icd.charttime) >= 365/4
Flattened: {'sel': 'avg', 'agg': ['d_icd_diagnoses.icd_code', 'diagnoses_icd.charttime', 'patients.dod'], 'tab': ['d_icd_diagnoses', 'diagnoses_icd', 'patients'], 'cond': [['d_icd_diagnoses.long_title', '=', 'asymptomatic human immunodeficiency virus [hiv] infection status'], ["strftime('%j','2100-12-31 23:59:00') - strftime('%j',diagnoses_icd.charttime)", '>=', '365/4']]}
----------
TRUTH:
SELECT AVG(C1) FROM ( SELECT ( CASE WHEN (strftime('%J',patients.dod) - strftime('%J',T1.charttime)) < 1 * 365/4 THEN 0 ELSE 1 END ) AS C1 FROM ( SELECT admissions.subject_id, diagnoses_icd.charttime FROM diagnoses_icd JOIN admissions ON diagnoses_icd.hadm_id = admissions.hadm_id WHERE diagnoses_icd.icd_code = ( SELECT d_icd_diagnoses.icd_code FROM d_icd_diagnoses WHERE d_icd_diagnoses.long_title = 'asymptomatic human immunodeficiency virus [hiv] infection status' ) AND strftime('%J',current_time) - strftime('%J',diagnoses_icd.charttime) >= 1 * 365/4 GROUP BY admissions.subject_id HAVING MIN(diagnoses_icd.charttime) = diagnoses_icd.charttime ) AS T1 JOIN patients ON T1.subject_id = patients.subject_id )
